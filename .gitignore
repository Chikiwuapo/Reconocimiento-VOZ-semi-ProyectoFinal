# === Global ignores ===
# OS/IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env files (keep examples tracked)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Project logs (explicit)
backend/facial_debug.log

# === Frontend (Node/Vite/React) ===
node_modules/
dist/
dist-ssr/
*.local

# === Python/Django ===
__pycache__/
*.py[cod]
*$py.class

# Packaging
*.egg-info/
.eggs/
build/
dist/

# Django
db.sqlite3
staticfiles/
media/

# Virtual environments
venv/
.venv/
ENV/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Misc
*.bak
*.tmp
*.temp
~$*
