# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
DJANGO_SETTINGS_MODULE=core.settings

# Database Configuration (SQLite for development/production)
# Leave DATABASE_URL empty to use SQLite by default
DATABASE_URL=

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=your-render-app.onrender.com,devproyectos.com,localhost,127.0.0.1

# CORS Configuration (comma-separated)
CORS_ALLOWED_ORIGINS=https://devproyectos.com,http://localhost:3000,http://localhost:5173

# CSRF Configuration (comma-separated)
CSRF_TRUSTED_ORIGINS=https://your-render-app.onrender.com,https://devproyectos.com

# Optional: MySQL Configuration (if using MySQL instead of SQLite)
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=your_database_host
# DB_PORT=3306